# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — your React dev server origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database. Leave USE_SQLITE=True to start quickly with SQLite.
# Set USE_SQLITE=False and fill DATABASE_* to use PostgreSQL.
USE_SQLITE=True
DATABASE_NAME=medical_dashboard
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Auth is self-contained (JWT). No external service account needed.
# Tokens are signed with SECRET_KEY above.
