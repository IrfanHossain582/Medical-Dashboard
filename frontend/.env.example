# Copy to .env. Self-contained JWT auth — no external keys needed.
VITE_API_URL=http://localhost:8000/api/v1

# Optional: Google OAuth client ID for patient "Continue with Google" login.
# Create one at https://console.cloud.google.com/apis/credentials (Web app),
# add http://localhost:5173 as an authorized JavaScript origin, and put the
# same client ID in the backend .env as GOOGLE_CLIENT_ID.
# Leave blank to disable Google login (email/password still works).
VITE_GOOGLE_CLIENT_ID=
